{
  "name": "connect",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:watch": "vitest",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"services/**/*.ts\" \"client/**/*.ts\" \"config/**/*.ts\" \"hooks/**/*.ts\" \"store/**/*.ts\" \"types/**/*.ts\" \"utils/**/*.ts\" \"app/**/*.css\" \"**/*.mjs\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"services/**/*.ts\" \"client/**/*.ts\" \"config/**/*.ts\" \"hooks/**/*.ts\" \"store/**/*.ts\" \"types/**/*.ts\" \"utils/**/*.ts\" \"app/**/*.css\" \"**/*.mjs\" \"*.ts\" \"*.json\"",
    "audit": "npm audit --audit-level=high",
    "sonar": "node scripts/sonar-scanner.js",
    "sonar:lint": "node scripts/sonar-scanner.js --lint-only || true",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db execute --file supabase/seeds/dev_data.local.sql",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > supabase/database.types.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@teispace/next-themes": "^3.0.2",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "ably": "^2.28.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "meilisearch": "^0.62.0",
    "next": "^16.3.5",
    "posthog-node": "^5.52.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/speakeasy": "^2.0.10",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "sonarqube-scanner": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
