# ─── Connect — environment ───────────────────────────────────────────────
# Copy to `.env.local` and fill in real values. Every key is validated by
# lib/env.ts (zod). Required keys throw at first server-side use; optional
# integrations fail closed when unset — see lib/env.ts.

# ── Public (safe to ship to the browser) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional public keys:
# NEXT_PUBLIC_SENTRY_DSN=https://...
# NEXT_PUBLIC_SENTRY_RELEASE=connect@1.0.0
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
# NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Server secrets (never expose to the client) ──────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DB_URL_POOLED=postgresql://...

UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
ABLY_API_KEY=your-ably-api-key
RESEND_API_KEY=re_your-key
EMAIL_FROM="Connect <no-reply@example.com>"

# HMAC seed for CSRF protection — at least 32 characters.
CSRF_SECRET=replace-with-a-32+character-random-string
# Worker-auth secret for /api/queue/worker — at least 16 characters.
# WORKER_SECRET=replace-with-a-random-secret

# ── Optional integrations (fail closed when absent) ──────────────────────
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=connect@1.0.0
# Sampling for performance traces (0–1). Defaults to 0.1.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TURNSTILE_SECRET_KEY=0x...

# PostHog mirror (privacy-mode). Enables only when BOTH the key and a
# >=16-char pseudonym secret are set.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PSEUDONYM_SECRET=at-least-16-characters

# Meilisearch (optional search enhancement; falls back to in-DB search when off)
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=your-master-key
# MEILISEARCH_INDEX_PREFIX=connect_

# ── LinkedIn OIDC scopes (optional) ─────────────────────────────────────────
# Space-separated scopes the app requests on LinkedIn sign-in. Defaults to
# identity-only ('openid profile email'); extend ONLY when the LinkedIn app is
# approved for the product (e.g. 'r_basicprofile' for headline). Unknown scope
# names log a warning and fall back to identity — sign-in never breaks.
# See docs/LINKEDIN_SETUP.md.
# LINKEDIN_OAUTH_SCOPES=openid profile email

# ── Operator tooling (LOCAL ONLY — never set these in a deployed env) ──────
# Consumed exclusively by scripts/linkedin-login.mjs, which drives the real
# LinkedIn OAuth handshake to cache an authenticated Playwright session in
# playwright/.auth/ (gitignored). The app runtime never reads these keys.
# Leave them unset in every environment except a local dev machine.
# LINKEDIN_TEST_EMAIL=you@example.com
# LINKEDIN_TEST_PASSWORD=your-linkedin-password